# Copie este archivo como .env y complete los valores.
# El .env tiene credenciales: no se sube al repositorio (está en .gitignore).

# URI del cluster de MongoDB Atlas: en Atlas, botón "Connect" > "Drivers".
# Si la contraseña tiene caracteres especiales (@ : / ? # [ ] %), deben ir
# codificados; por ejemplo, @ se escribe %40.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Base de datos del proyecto. Las pruebas usan otra base: <MONGODB_DB>_test.
MONGODB_DB=agencia_viajes
